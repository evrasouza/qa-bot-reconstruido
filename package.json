{
  "name": "qa-bot",
  "version": "1.0.0",
  "description": "Playwright-based health check crawler and test generator for large-scale page validation.",
  "main": "index.js",
  "scripts": {
    "crawl": "tsx crawler/crawler.ts",
    "generate": "tsx generator/generate-tests.ts",
    "allure:prepare": "node scripts/prepare-allure.js",
    "allure:history": "node scripts/copy-allure-history.js",
    "allure:reset": "node scripts/reset-allure-results.js",
    "test:auto": "npm run allure:reset && npm run allure:prepare && playwright test",
    "test:auto:append": "playwright test",
    "test:lynx": "playwright test --project=brplynx_com",
    "test:e2e": "npm run allure:reset && npm run allure:prepare && playwright test --project=e2e tests/e2e",
    "test:e2e:append": "playwright test --project=e2e tests/e2e",
    "test:quote": "playwright test --project=e2e tests/e2e/get-a-quote.spec.ts",
    "test:quote:headed": "playwright test --project=e2e tests/e2e/get-a-quote.spec.ts --headed",
    "test:menu": "playwright test --project=e2e tests/e2e/menu-navigation.spec.ts",
    "test:menu:headed": "playwright test --project=e2e tests/e2e/menu-navigation.spec.ts --headed",
    "test:full": "npm run allure:reset && npm run allure:prepare && npm run test:auto:append && npm run test:e2e:append && npm run test:menu:all",
    "report": "playwright show-report",
    "report:allure": "npm run allure:history && allure generate allure-results --clean -o allure-report && allure open allure-report",
    "mark:manual": "tsx scripts/mark-manual-tests.ts",
    "test:menu:all": "tsx scripts/run-menu-all.ts",
    "test:menu:all:headed": "tsx scripts/run-menu-all.ts",
    "test:promotion": "playwright test --project=e2e tests/e2e/promotion-page.spec.ts",
    "test:promotion:headed": "playwright test --project=e2e tests/e2e/promotion-page.spec.ts --headed",
    "test:menu:allpromo": "tsx scripts/run-promotions-all.ts",
    "report:allure:pdf": "tsx scripts/export-allure-pdf.ts",
    "report:shared": "tsx scripts/generate-shareable-report.ts",
    "figma:ui": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' tests/e2e/figma-ui-inspector/figma-vs-ui-inspector.ts",
    "test:dictionary": "npx playwright test tests/api/dictionary --project=api",
    "report:dictionary": "tsx scripts/generate-dictionary-report.ts",
    "test:dictionary:dev2:de": "DICTIONARY_ENV=dev2 DICTIONARY_LOCALE=de-de npx playwright test tests/api/dictionary/dictionary.spec.ts --project=api",
    "test:dictionary:dev2:en-ca": "DICTIONARY_ENV=dev2 DICTIONARY_LOCALE=en-ca npx playwright test tests/api/dictionary/dictionary.spec.ts --project=api",
    "test:dictionary:prod:de": "DICTIONARY_ENV=prod DICTIONARY_LOCALE=de-de npx playwright test tests/api/dictionary/dictionary.spec.ts --project=api",
    "test:api:consents:headed": "playwright test tests/api/consents --headed",
    "test:api:consents:debug": "playwright test tests/api/consents --debug",
    "test:api:consents": "playwright test tests/api/consents",
    "report:consents": "node scripts/generate-consents-report.js",
    "test:api:consents:report": "playwright test tests/api/consents && node scripts/generate-consents-report.js"    
  },
  "keywords": [
    "playwright",
    "qa",
    "crawler",
    "health-check",
    "automation",
    "seo",
    "links",
    "validation"
  ],
  "author": "Everton Souza",
  "license": "ISC",
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.58.2",
    "allure-commandline": "^2.38.1",
    "allure-playwright": "^3.6.0",
    "dotenv": "^17.4.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "cheerio": "^1.2.0",
    "playwright": "^1.58.2"
  }
}
